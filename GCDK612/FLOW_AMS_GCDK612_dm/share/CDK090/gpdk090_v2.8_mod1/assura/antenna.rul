drcExtractRules(

; procedure for switches CHECK_CONT_ANT_3
procedure( switchProc0()
    geomConnect(
        via(cont_poly cont_antenna Poly)
    )

    processAntenna(
        gate((gate Poly))
        antenna(cont_antenna)
        ratio=(cont_antenna.area/gate.area)
        drcAntenna(cont_antenna (gate Poly cont_antenna) ratio keep>15.0
            "ANT.3: Poly Contact area to gate area ratio must be <= 15.0")
    )

)

; procedure for switches CHECK_METAL1_ANT_4
procedure( switchProc1()
    geomConnect(
        via(cont_poly metal1_wo_diode Poly)
    )

    processAntenna(
        gate((gate Poly))
        antenna(metal1_wo_diode)
        ratio=(metal1_wo_diode.area/gate.area)
        drcAntenna(metal1_wo_diode (gate Poly metal1_wo_diode) ratio keep>475.0
            "ANT.4.M1: Metal1 area to gate area ratio must be <= 475.0")
    )

)

; procedure for switches CHECK_METAL1_ANT_7
procedure( switchProc2()
    geomConnect(
        via(cont_diode metal1_with_diode diff_diode)
        via(cont_poly metal1_with_diode Poly)
    )

    processAntenna(
        gate((gate Poly))
        antenna(metal1_with_diode)
        diffusion(diff_diode)
        ratio=((metal1_with_diode.area/gate.area)-((diff_diode.area*500.0)+45000.0))
