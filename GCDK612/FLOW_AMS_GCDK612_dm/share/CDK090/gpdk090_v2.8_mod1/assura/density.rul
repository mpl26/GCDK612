drcExtractRules(

; procedure for switches CHECK_DENSITY
procedure( switchProc0()
    L615=drc(Poly coverage<1 )
    errorLayer(geomGetCoverage(L615 keep>0.5)
        "POLY.D.1: Poly density must be <= 50%")

    L74985=drc(metal1_conn coverage<1  windowSize=120.0 stepSize=60.0)
    errorLayer(geomGetCoverage(L74985 0.20<=ignore<=0.65)
        "METAL1.D.1: Metal1 density must be >= 20% <= 65%")

    L34856=drc(metal2_conn coverage<1  windowSize=120.0 stepSize=60.0)
    errorLayer(geomGetCoverage(L34856 0.20<=ignore<=0.65)
        "METAL2.D.1: Metal2 density must be >= 20% <= 65%")

    L94727=drc(metal3_conn coverage<1  windowSize=120.0 stepSize=60.0)
    errorLayer(geomGetCoverage(L94727 0.20<=ignore<=0.65)
        "METAL3.D.1: Metal3 density must be >= 20% <= 65%")

    L54598=drc(metal4_conn coverage<1  windowSize=120.0 stepSize=60.0)
    errorLayer(geomGetCoverage(L54598 0.20<=ignore<=0.65)
        "METAL4.D.1: Metal4 density must be >= 20% <= 65%")

    L14469=drc(metal5_conn coverage<1  windowSize=120.0 stepSize=60.0)
    errorLayer(geomGetCoverage(L14469 0.20<=ignore<=0.65)
