; Metal1_d_n=if MergePinAndNet Metal1_d or Metal1_n else Metal1_d
if( avSwitch("MergePinAndNet") then
    Metal1_d_n=geomOr(Metal1_d Metal1_n)
else
    Metal1_d_n=Metal1_d
)


; Metal1=Metal1_d_n or Metal1_p
Metal1=geomOr(Metal1_d_n Metal1_p)

