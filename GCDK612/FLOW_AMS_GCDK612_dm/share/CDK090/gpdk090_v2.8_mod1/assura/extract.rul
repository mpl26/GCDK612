Bondpad=geomOr(Bondpad Bondpad_pin)
CapMetal=geomOr(CapMetal CapMetal_pin)
INDdummy=geomOr(INDdummy INDdummy_pin)
Metal1_d=geomOr(Metal1_d Metal1_d_pin)
Metal1_p=geomOr(Metal1_p Metal1_p_pin)
Metal2_d=geomOr(Metal2_d Metal2_d_pin)
Metal2_p=geomOr(Metal2_p Metal2_p_pin)
Metal3_d=geomOr(Metal3_d Metal3_d_pin)
Metal3_p=geomOr(Metal3_p Metal3_p_pin)
Metal4_d=geomOr(Metal4_d Metal4_d_pin)
Metal4_p=geomOr(Metal4_p Metal4_p_pin)
Metal5_d=geomOr(Metal5_d Metal5_d_pin)
Metal5_p=geomOr(Metal5_p Metal5_p_pin)
Metal6_d=geomOr(Metal6_d Metal6_d_pin)
Metal6_p=geomOr(Metal6_p Metal6_p_pin)
Metal7_d=geomOr(Metal7_d Metal7_d_pin)
Metal7_p=geomOr(Metal7_p Metal7_p_pin)
Metal8_d=geomOr(Metal8_d Metal8_d_pin)
Metal8_p=geomOr(Metal8_p Metal8_p_pin)
Metal9_d=geomOr(Metal9_d Metal9_d_pin)
Metal9_p=geomOr(Metal9_p Metal9_p_pin)
Nburied=geomOr(Nburied Nburied_pin)
Nimp=geomOr(Nimp Nimp_pin)
Nwell=geomOr(Nwell Nwell_pin)
Pimp=geomOr(Pimp Pimp_pin)
Poly=geomOr(Poly Poly_pin)
Psub=geomOr(Psub Psub_pin)


; Metal1_v=Metal1_p and Metal1_d
Metal1_v=geomAnd(Metal1_d Metal1_p)

; Metal2_v=Metal2_p and Metal2_d
Metal2_v=geomAnd(Metal2_d Metal2_p)

; Metal3_v=Metal3_p and Metal3_d
Metal3_v=geomAnd(Metal3_d Metal3_p)

; Metal4_v=Metal4_p and Metal4_d
Metal4_v=geomAnd(Metal4_d Metal4_p)

; Metal5_v=Metal5_p and Metal5_d
Metal5_v=geomAnd(Metal5_d Metal5_p)

; Metal6_v=Metal6_p and Metal6_d
Metal6_v=geomAnd(Metal6_d Metal6_p)

; Metal7_v=Metal7_p and Metal7_d
Metal7_v=geomAnd(Metal7_d Metal7_p)

; Metal8_v=Metal8_p and Metal8_d
Metal8_v=geomAnd(Metal8_d Metal8_p)

; Metal9_v=Metal9_p and Metal9_d
Metal9_v=geomAnd(Metal9_d Metal9_p)

; SNA
; NOD=Oxide and Nimp
NOD=geomAnd(Nimp Oxide)

; SNA
; POD=Oxide and Pimp
POD=geomAnd(Oxide Pimp)

; cont_poly=Cont and Poly
cont_poly=geomAnd(Cont Poly)

; SNA
; dev_nw=Nwell cut ResWdum
dev_nw=geomStraddle(Nwell ResWdum)

; SNA
; dw_sna=Nburied and Nwell
dw_sna=geomAnd(Nburied Nwell)

; ind_term1=INDdummy and IND2dummy
ind_term1=geomAnd(IND2dummy INDdummy)

; ind_term2=INDdummy and IND3dummy
ind_term2=geomAnd(IND3dummy INDdummy)

; SNA
; nact=NOD andnot Nwell
nact=geomAndNot(NOD Nwell)

; nactive=Nimp and Oxide
nactive=geomCat(NOD)

; nb_tap=Nburied and Nwell
nb_tap=geomCat(dw_sna)

; npn_base=Psub and NPNdummy
npn_base=geomAnd(NPNdummy Psub)

; SNA
; ntie=NOD andnot nact
ntie=geomAndNot(NOD nact)

; SNA
; ntie_n=ntie andnot Nburied
ntie_n=geomAndNot(ntie Nburied)

; SNA
; ntie_ns=ntie_n
ntie_ns=geomCat(ntie_n)

; SNA
; ntie_dn=ntie andnot ntie_n
ntie_dn=geomAndNot(ntie ntie_n)

; SNA
; ntie_dns=ntie_dn
ntie_dns=geomCat(ntie_dn)

; SNA
; nw_dnw=Nwell or Nburied
nw_dnw=geomOr(Nburied Nwell)

; SNA
; nw_sna=Nwell andnot Nburied
nw_sna=geomAndNot(Nwell Nburied)

; SNA
; nwell_sna1=nw_sna andnot dev_nw
nwell_sna1=geomAndNot(nw_sna dev_nw)

; pactive=Pimp and Oxide
pactive=geomCat(POD)

; pdiff=pactive andnot Poly
pdiff=geomAndNot(pactive Poly)

; poly_conn=Poly andnot Resdum
poly_conn=geomAndNot(Poly Resdum)

; ndiff=(nactive andnot poly_conn)
ndiff=geomAndNot(nactive poly_conn)

; SNA
; ptie=POD andnot Nwell
ptie=geomAndNot(POD Nwell)

; SNA
; ptie_d=ptie andnot nw_dnw
ptie_d=geomAndNot(ptie nw_dnw)

; SNA
; ptie_ds=ptie_d
ptie_ds=geomCat(ptie_d)

; SNA
; ptie_t=ptie andnot ptie_d
ptie_t=geomAndNot(ptie ptie_d)

; SNA
; ptie_ts=ptie_t
ptie_ts=geomCat(ptie_t)

; SNA
; tw_sna=Nburied andnot Nwell
tw_sna=geomAndNot(Nburied Nwell)

; via2_cap=Via2 and CapMetal
via2_cap=geomAnd(CapMetal Via2)

; _rnwellod=(Nwell and SiProt) and ResWdum
L40182=geomAnd(Nwell SiProt)
_rnwellod=geomAnd(L40182 ResWdum)

; _rnwellsti=(Nwell notInteract SiProt) and ResWdum
L25544=geomAvoiding(Nwell SiProt)
_rnwellsti=geomAnd(L25544 ResWdum)

; cont_base=Cont and npn_base and pdiff
L82025=geomAnd(Cont npn_base)
cont_base=geomAnd(L82025 pdiff)

; ndiff_conn=ndiff andnot Resdum andnot NPNdummy
L46829=geomAndNot(ndiff Resdum)
ndiff_conn=geomAndNot(L46829 NPNdummy)

; cont_ndiff=Cont and ndiff_conn
cont_ndiff=geomAnd(Cont ndiff_conn)

; ntap=Nwell and ndiff_conn
ntap=geomAnd(Nwell ndiff_conn)

; npn_emit=Nwell andnot ResWdum and NPNdummy
L59011=geomAndNot(Nwell ResWdum)
npn_emit=geomAnd(L59011 NPNdummy)

; cont_emit=Cont and npn_emit andnot Psub
L82635=geomAnd(Cont npn_emit)
cont_emit=geomAndNot(L82635 Psub)

; nwell_conn=Nwell andnot ResWdum andnot NPNdummy
nwell_conn=geomAndNot(L59011 NPNdummy)

; pdiff_conn=pdiff andnot Resdum andnot NPNdummy
L12267=geomAndNot(pdiff Resdum)
pdiff_conn=geomAndNot(L12267 NPNdummy)

; _pnp=(pdiff_conn and PNPdummy)
_pnp=geomAnd(PNPdummy pdiff_conn)

; cont_pdiff=Cont and pdiff_conn
cont_pdiff=geomAnd(Cont pdiff_conn)

; ptap=(pdiff_conn andnot Nwell)
ptap=geomAndNot(pdiff_conn Nwell)

; _vpnp2=(pdiff_conn and BJTdum and VPNP2dum)
L68803=geomAnd(BJTdum pdiff_conn)
_vpnp2=geomAnd(L68803 VPNP2dum)

; _vpnp5=(pdiff_conn and BJTdum and VPNP5dum)
_vpnp5=geomAnd(L68803 VPNP5dum)

; _vpnp10=(pdiff_conn and BJTdum and VPNP10dum)
_vpnp10=geomAnd(L68803 VPNP10dum)

; Metal1_d_n=if MergePinAndNet Metal1_d or Metal1_n else Metal1_d
if( avSwitch("MergePinAndNet") then
    Metal1_d_n=geomOr(Metal1_d Metal1_n)
else
    Metal1_d_n=geomCat(Metal1_d)
)


; Metal1=Metal1_d_n or Metal1_p
Metal1=geomOr(Metal1_d_n Metal1_p)

; _resm1=(Metal1 andnot Metal1_slot) and M1Resdum
L32159=geomAndNot(Metal1 Metal1_slot)
_resm1=geomAnd(L32159 M1Resdum)

; metal1_conn=(Metal1 andnot Metal1_slot) andnot M1Resdum
metal1_conn=geomAndNot(L32159 M1Resdum)

; Metal2_d_n=if MergePinAndNet Metal2_d or Metal2_n else Metal2_d
if( avSwitch("MergePinAndNet") then
    Metal2_d_n=geomOr(Metal2_d Metal2_n)
else
    Metal2_d_n=geomCat(Metal2_d)
)


; Metal2=Metal2_d_n or Metal2_p
Metal2=geomOr(Metal2_d_n Metal2_p)

; _resm2=(Metal2 andnot Metal2_slot) and M2Resdum
L6015=geomAndNot(Metal2 Metal2_slot)
_resm2=geomAnd(L6015 M2Resdum)

; ind_term1_tap=Metal2 and INDdummy and IND2dummy
L41497=geomAnd(INDdummy Metal2)
ind_term1_tap=geomAnd(IND2dummy L41497)

; ind_term2_tap=Metal2 and INDdummy and IND3dummy
ind_term2_tap=geomAnd(IND3dummy L41497)

