extractMOS("nmos1v" _nmos_12 poly_conn("G") ndiff_conn("S" "D") psubstrate("B")
    cellView("nmos1v ivpcell gpdk090") flagMalformed)
if( avSwitch("SNA") then saveRecognition(nmos1v "device"))
width=measureParameter(length (_nmos_12 butting ndiff_conn) 0.5)
length=measureParameter(length (_nmos_12 outside ndiff_conn) 0.5)
w=calculateParameter(width*1e-6)
attachParameter(w "w" _nmos_12)
fw=calculateParameter(width*1e-6)
attachParameter(fw "fw" _nmos_12)
simW=calculateParameter(width*1e-6)
attachParameter(simW "simW" _nmos_12)
l=calculateParameter(length*1e-6)
attachParameter(l "l" _nmos_12)

