  if( avSwitch( "SNA" ) then
;   additional, specific device exclusion section :
;   nwell diodes and pnp base from nwell and npn base from ipwell
    nwell_diodes  = geomOverlap( Nwell geomOr( _ndio _pdio ) )
    nwell_pnp     = geomButtOrOver( Nwell _vpnp2 )
    nwell_exclude = geomOr( nwell_diodes nwell_pnp )
    nwell_sna     = geomAndNot( nwell_sna1 nwell_exclude )
    twell_exclude = geomButtOrOver( tw_sna BJTdum )
    twell_sna     = geomAndNot( tw_sna twell_exclude )
    ntie_nwell    = geomAnd( ntie_n nwell_sna )
    ptie_twell    = geomAnd( ptie_t twell_sna )
    extractDevice( "TIE" ptie_d     ptie_ds("P1")  physical )
    extractDevice( "TIE" ntie_nwell ntie_ns("P1")  physical )
    extractDevice( "TIE" ntie_dn    ntie_dns("P1") physical )
    extractDevice( "TIE" ptie_twell ptie_ts("P1")  physical )
    saveRecognition( ptie_d      "device" )
    saveRecognition( ntie_nwell  "device" )
    saveRecognition( ntie_dn     "device" )
    saveRecognition( ptie_twell  "device" )
    saveDerived( nwell_sna ("SNA" "nwell")  ext_view )
    saveDerived( dw_sna    ("SNA" "dnwell") ext_view )
    saveDerived( twell_sna ("SNA" "ipwell") ext_view )
  )
  
;   additional interconnect saved for recognition :
;
saveInterconnect((Oxide "Oxide"))
saveInterconnect((Oxide_thk "Oxide_thk"))

