#!/bin/ksh

# Version: 2.02

setExeVar() { eval `echo ${2} | /bin/tr '[:lower:]' '[:upper:]'`=\"${1}${2}\"; }
setExeVars() { P="${1}"; shift; for i in $@; { setExeVar "${P}" ${i}; } }
setExeVars "" connect emerge eprint epick ereduce flatnet flattrans \
              flattub geom grow inter netprint

# Usage: beginFlattenInputs
# Outputs:
#    SAVEDIR - (Env. Var.) Directory where files will
#       be stored prior to flattening
beginFlattenInputs() {
  SAVEDIR=flattenInputs/
  /bin/mkdir -p ${SAVEDIR}
}

# Usage: changeTransFileNameAP infile outfile
# Inputs:
#    infile.ap - trans ap file
# Outputs:
#    outfile.ap - renamed trans ap file
changeTransFileNameAP() {
  [ -r "${1}.ap" ] && {
    [ -r "${2}.ap" ] && /bin/rm -f ${2}.ap
    /bin/ln -s ${1}.ap ${2}.ap
  }
  [ -r "${1}.nr" ] && {
    [ -r "${2}.nr" ] && /bin/rm -f ${2}.nr
    /bin/ln -s ${1}.nr ${2}.nr
  }
  [ -r "${1}.box" ] && {
    [ -r "${2}.box" ] && /bin/rm -f ${2}.box
    /bin/ln -s ${1}.box ${2}.box
  }
  return 0
}

# Usage: moveTpickTransFile intransfile outtransfile
# Inputs:
#    intransfile - tpick'd transistor file
# Outputs:
#    outtransfile - original transistor file
moveTpickTransFile() {
  [ -r "${1}" ] && {
    /bin/mv -f ${1} ${2}
  }
  [ -r "${1}.ap" ] && {
    /bin/mv -f ${1}.ap ${2}.ap
  }
  [ -r "${1}.nr" ] && {
    /bin/mv -f ${1}.nr ${2}.nr
  }
  [ -r "${1}.box" ] && {
    /bin/mv -f ${1}.box ${2}.box
  }
  return 0
}

# Usage: checkCapGround netfile ground-name
# Outputs:
#    none
checkCapGround() {
  set +e
  ${NETPRINT} -l ${2} ${1} > /dev/null
  [ "$?" -ne "0" ] && {
    echo $0: cap ground signal \'"${2}"\' does not exist
    exit 1
  }
  set -e
}

# Usage: createBJTModelFile filename modelname
# Inputs:
#    modelname - bipolar model name
# Outputs:
#    filename - bipolar model file
createBJTModelFile() {
  MODEL=${2}
  echo "*
	${MODEL} N 1.0
	${MODEL} P 1.0
	${MODEL} X 1.0
*
	${MODEL} N 1000.001 1000.001 1000.0
	${MODEL} P 1000.001 1000.001 1000.0
	${MODEL} X 1000.001 1000.001 1000.0" > ${1}
}

# Usage: createCapDiodeTerm devlayer interconnect terminal
# Inputs:
#    devlayer - device layer
#    interconnect - connectable layer
# Outputs:
#    terminal - terminal formed from device layer and interconect layer
createCapDiodeTerm() {
  [ -f "${3}" ] && /bin/rm -f ${3}
  ${GEOM} -V ${1} ${2} - ${1}.tmp,11,n
  ${EREDUCE} -V -n1 -r ${1}.tmp ${3}
  /bin/rm -f ${1}.tmp
}

# Usage: createCAPModelFile filename model scale devlayer term1 term2 [term3]
# Inputs:
#    model - cap model name
#    scale - area scale factor
#    devlayer - device layer
#    term1 - 1st conductor layer
#    term2 - 2nd conductor layer
#    term3 - backgate
# Outputs:
#    filename - CAP model file
createCAPModelFile() {
  OUT=${1}
  MODEL=${2}
  SCALE=${3}
  shift 3
  [ $# -eq 3 ] && {
    echo "*
	  $@
	  C 2, 3(1), ${MODEL}, 0, 0, 1, 1, :a, ${SCALE}, 111:p, 0, 0xx" > ${OUT}
  } || {
    echo "*
	  $@
	  C 2, 3,4(1), ${MODEL}, 0, 0, 1, 1, :a, ${SCALE}, 1111:p, 0, 0xxx" > ${OUT}
  }
}

# Usage: createDIODEModelFile filename model scale devlayer term1 term2 [term3]
# Inputs:
#    model - diode model name
#    scale - scale factor
#    devlayer - device layer
#    term1 - 1st conductor layer
