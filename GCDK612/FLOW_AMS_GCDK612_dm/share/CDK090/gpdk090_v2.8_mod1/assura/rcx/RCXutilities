# Usage: createEmptyLayer layername
# Outputs:
#    layername - empty edge file
createEmptyLayer() {
  [ -f "${1}" ] && /bin/rm -f ${1}
  echo "${1}:" > ${1}.tmp
  ${EPRINT} -1 ${1}.tmp
  ${CONNECT} -V ${1} - -
  /bin/rm -f ${1}.tmp
}

