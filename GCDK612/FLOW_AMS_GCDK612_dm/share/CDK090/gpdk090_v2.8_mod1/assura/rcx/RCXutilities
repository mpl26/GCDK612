# Usage: mergeLayers outlayer inlayer1 [inlayer2 ...]
# Inputs:
#    inlayer1 - input layer1
#    inlayer2 ... - optional input layers
# Outputs:
#    outlayer - output layer
mergeLayers() {
  case $# in
    0|1)
       echo usage: mergeLayers outlayer inlayer1 [inlayer2 ...] >&2
       exit 1
       ;;
    2)
       [ "${1}" != "${2}" ] && /bin/cp ${2} ${1}
       return 0
       ;;
    3)
       [ "${2}" = "${3}" ] && {
         /bin/cp ${2} ${1}
       } || {
         ${EMERGE} -V ${2} ${3} ${1}.tmp
         ${GEOM} -V ${1}.tmp - ${1},1,i,1
         /bin/rm -f ${1}.tmp
       }
       ;;
    *)
       RCX_OUT=${1}
       shift
       k=0
       until [ $# -le 1 ]; do
	 ((k = ${k} + 1))
	 ${EMERGE} -V ${1} ${2} tmp${k}
	 shift 2
       done
       [ $# -eq 1 ] && {
	 ((k = ${k} + 1))
	 ${EMERGE} -V ${1} tmp1 tmp${k}
	 /bin/rm -f tmp1
	 i=2
       } || { i=1; }
       while [ ${i} -lt ${k} ]; do
	 ((j = ${i} + 1))
	 ((k = ${k} + 1))
	 ${EMERGE} -V tmp${i} tmp${j} tmp${k}
	 /bin/rm -f tmp${i} tmp${j}
	 ((i = ${j} + 1))
       done
       /bin/mv tmp${k} ${RCX_OUT}
       ${GEOM} -V ${RCX_OUT} - ${RCX_OUT},1,i,1
       ;;
  esac
}

