# Usage: flattenLayers layers
# Inputs:
#    layers - list of polygon data layers (with or without
#       connectivity info)
# Outputs:
#    layers - list of flattened polygon data layers (with or
#       without connectivity info)
flattenLayers() {
  j=1
  /bin/mv $* ${SAVEDIR}
  for i in $*; {
    [ "${j}" = "1" ] && {
      INLAY="${SAVEDIR}${i}"
      OUTLAY="${i}"
    } || {
      INLAY="${INLAY},${SAVEDIR}${i}"
      OUTLAY="${OUTLAY},${i}"
    }
    ((j = ${j} + 1))
  }
  ${FLATTUB} -V -F -m ${INLAY} ${OUTLAY}
}

