         /bin/cp ${2} ${1}
       } || {
         ${EMERGE} -V ${2} ${3} ${1}
       }
       ;;
    *)
       RCX_OUT=${1}
       shift
       k=0
       until [ $# -le 1 ]; do
	 ((k = ${k} + 1))
	 ${EMERGE} -V ${1} ${2} tmp${k}
	 shift 2
       done
       [ $# -eq 1 ] && {
	 ((k = ${k} + 1))
	 ${EMERGE} -V ${1} tmp1 tmp${k}
	 /bin/rm -f tmp1
	 i=2
       } || { i=1; }
       while [ ${i} -lt ${k} ]; do
	 ((j = ${i} + 1))
