       done
       /bin/mv tmp${k} ${RCX_OUT}
       ;;
  esac
}

# Usage: resizeLayer grow-amt in-layer [out-layer]
# Outputs:
#    out-layer/in-layer - grown version of in-layer.
#	  if out-layer is omitted, in-layer is
#	  overwritten
resizeLayer() {
  case $# in
    2)
       ${GROW} -V -m ${1} ${2} ${2}.tmp
       /bin/mv ${2}.tmp ${2}
       ;;
    3)
       ${GROW} -V -m ${1} ${2} ${3}
       ;;
    *)
       echo usage: resizeLayer grow-amt in-layer [out-layer] >&2
       exit 1
       ;;
  esac
}

# Usage: selectNets netfile namefile inset subset complement
# Inputs:
#    netfile - name to net id number data file
#    namefile - name of nets to be selected
#    inset - input layer
# Outputs:
#    subset - selected subset of inlayer
#    complement - complement of subset
selectNets() {
  if [ $# -ne 5 ]; then
    selectNets $@
    echo "Usage: selectNets netfile namefile inset subset complement" 1>&2
    exit 1
  fi
  ${EPICK} -V -l ${2} -n ${1} ${3} ${4}
  ${EPICK} -V -l ${2} -n ${1} -c ${3} ${5}
}

# Usage: selecteNetsByNumber numfile inset subset complement
# Inputs:
#    numfile - id numbers of nets to be selected
#    inset - input layer
# Outputs:
#    subset - selected subset of inlayer
#    complement - complement of subset
selectNetsByNumber() {
  if [ $# -ne 4 ]; then
    echo selectNetsByNumber $@
    echo "Usage: selectNetsByNumber numfile inset subset complement" 1>&2
    exit 1
  fi
  ${EPICK} -V -f ${1} ${2} ${3}
  ${EPICK} -V -f ${1} -c ${2} ${4}
}

# Usage: selectExcludedNetsByNumber powerfile excludefile netfile inset capground subset complement mode
# Inputs:
#    powerfile - id numbers of power nets to be selected
#    excludefile - names of excluded nets to be selected
#    netfile - name of the RCX netfile
#    inset - input layer
#    capground - the value of variable ${CAP_GROUND}
#    mode - specifies coupled or decoupled extraction
# Outputs:
#    subset - selected subset of inlayer
#    complement - complement of subset
selectExcludedNetsByNumber() {
  if [ $# -ne 8 ]; then
    echo selectExcludedNetsByNumber $@
    echo "Usage: selectExcludedNetsByNumber powerfile excludefile netfile insetcapground subset complement mode" 1>&2
    exit 1
  fi
  ${EPICK} -V -f ${1} -l ${2} -n ${3} ${4} ${6}
  ${EPICK} -V -f ${1} -l ${2} -n ${3} -c ${4} ${7}
}

# Usage: selectViaOverlapRegions layer1 layer2 via output
# Inputs:
#    layer1 - connectable layer1
#    layer2 - connectable layer2
#    via - via which connects layer1 and layer2
# Outputs:
#    output - regions of layer1 and layer2 which overlap and
#             contain vias
selectViaOverlapRegions() {
  ${GEOM} -V ${1} ${2} - ${1}.${2}.tmp,11,n
  ${INTER} -V ${1}.${2}.tmp ${3} -P ${1}.${2}.${3}
  ${EPICK} -V -f ${1}.${2}.${3} ${1}.${2}.tmp ${4}
  /bin/rm -f ${1}.${2}.tmp ${1}.${2}.${3}
}

# Usage: setCapGround power-ground-file [ground-name]
# Outputs:
#    CAP_GROUND - (Env. Var.) lumped cap reference net
setCapGround() {
  if [ $# -eq 2 ]; then
    set +e
    /bin/cat ${1} | /bin/tr " ," \\\n\\\n | /bin/fgrep "${2}" > /dev/null
    if [ $? -ne 0 ]; then
      (echo Invalid lumped capacitance reference net \'"${2}"\'
       echo "It must be one of\n") 1>&2
      /bin/cat ${1} 1>&2
      CAP_GROUND=`/bin/head -1 ${1}`
      echo "\n"\'"${CAP_GROUND}"\' will be used instead 1>&2
    else
      CAP_GROUND=${2}
    fi
    set -e
  else
    if [ -s "${1}" ]; then
      CAP_GROUND=`/bin/head -1 ${1}`
    fi
  fi
}

# Usage: setTempDir directory
# Outputs:
#    TEMPDIR - (Env. Var.) directory for temporary files
setTempDir() {
  set +e
  /bin/touch ${1}/$$ 2> /dev/null
  [ "$?" != "0" ] && {
    echo $0: cannot create files in temporary directory \'${1}\' >&2
    exit 1
  }
  set -e
  /bin/rm -f ${1}/$$
  TEMPDIR=${1}
  export TEMPDIR
}
