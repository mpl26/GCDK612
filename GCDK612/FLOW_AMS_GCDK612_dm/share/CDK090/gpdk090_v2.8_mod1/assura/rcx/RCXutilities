# Usage: createRCXDir directory
# Outputs:
#    directory - RCX run directory
#    RCXDIR - (Env. Var.) RCX run directory
createRCXDir() {
  [ ! -d "${1}" ] && {
    set +e
    /bin/mkdir -p ${1};
    [ "$?" != "0" ] && {
      echo $0: cannot create RCX directory \'${1}\' >&2
      exit 1
    }
    set -e
  }
  RCXDIR=${1}
}

# Usage: endFlattenInputs
# Inputs:
#    RCX_SAVE_DATA - (Env. Var.) If set to anything,
#       data will be saved, otherwise it will be deleted
endFlattenInputs() {
  if [ -z "${RCX_SAVE_DATA}" ]; then
    /bin/rm -rf ${SAVEDIR}
  fi
}

# Usage: flattenBJTData deviceLayer
# Inputs:
#    deviceLayer - device recognition layer
#    deviceLayer.trans - BJT file
#    deviceLayer.net - device name mapping file
#    HIERARCHY_DELIMITER - delimiter for
#       flattening BJT names
# Outputs:
#    Same as inputs, but flattened.
flattenBJTData() {
  /bin/mv ${1} ${1}.qtrans* ${1}.net ${SAVEDIR}
  ${FLATTUB} -V -F -m ${SAVEDIR}${1} ${1}
  ${FLATTRANS} -V ${SAVEDIR}${1}.qtrans ${1}.qtrans
  ${FLATNET} -V -li -h '/' ${SAVEDIR}${1}.net ${1}.net
}

