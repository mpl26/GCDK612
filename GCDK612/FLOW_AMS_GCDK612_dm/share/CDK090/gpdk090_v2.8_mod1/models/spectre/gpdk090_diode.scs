simulator lang=spectre
library gpdk090
section dio
// 
//  *************************************************************
//                       MODEL OF N+/PW DIODE                   *
//                                                              *
//  *************************************************************
//                                                                              
//   
inline subckt gpdk090_ndio (1 2) 
parameters area=7.5e-8 pj=1.1e-3 rs=1.259e-07  
  r1 (1 3) resistor r=rs/area tc1=0.00277  
  diode (3 2) gpdk090_ndio_D area=area pj=pj 
ends gpdk090_ndio 
model gpdk090_ndio_D diode level=1 is=1e-05 n=1.3 bv=10.1 ibv=0.05  
+ ns=1.3 nz=1.3 imax=1e40 minr=1e-10 allow_scaling=1
+ isw=1.85e-11 cj=0.001376 vj=0.7956 mj=0.4528 cjsw=2.06e-10 vjsw=0.7956 mjsw=0.2323 
+ tlev=1 eg=1.17 xti=3 tbv1=0.000888 tlevc=1 cta=0.0009067 ctp=0.0002781 
+ pta=0.001427 ptp =0.001427 tnom=25 fc=0    
//                                                                              
//                                   *                                          
//                                      
//  *************************************************************
//                       MODEL OF P+/NW DIODE                   *
//                                                              *
//  *************************************************************
//                                                                              
//   
