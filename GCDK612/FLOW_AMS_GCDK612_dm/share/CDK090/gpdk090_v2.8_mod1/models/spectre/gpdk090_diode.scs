+  isw=2.04e-11 cj=0.0001291 vj=0.8122 mj=0.4897 cjsw=5.35e-10 vjsw=0.8122 
+ mjsw=0.2822 tlev=1 eg=1.17 xti=3 tbv1=0.00088 tlevc=1 cta=0.002483 
+ ctp=0.001238 pta=0.003184 ptp =0.003184 tnom=25 fc=0    
