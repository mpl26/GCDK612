+ ns=1.17 nz=1.17 imax=1e40 minr=1e-10 allow_scaling=1
+ isw=1.055e-12 cj=0.001369 vj=0.9 mj=0.4234 cjsw=9.8e-11 vjsw=0.9 mjsw=0.1716 
+ tlev=1 eg=1.17 xti=3 tbv1=0.000845 tlevc=1 cta=0.000887 ctp=0.000298 
+ pta=0.001643 ptp =0.001643 tnom=25 fc=0    
