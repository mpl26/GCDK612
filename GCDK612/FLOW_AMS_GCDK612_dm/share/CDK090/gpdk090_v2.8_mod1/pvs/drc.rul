#IFNDEF SUGGESTED_CHECK

    EDGEINSIDE oxide_in_res resdum_sz L28011;
    rule OXIDER.W.1.1 {
        CAPTION OXIDER.W.1.1: Oxide resistor width must be >= 0.2 um;
        INTE L28011 L28011 -lt 0.2 -OUTPUT REGION -ABUT lt 90;
    }

    EDGEINSIDE poly_in_res resdum_sz L52444;
    rule POLYR.W.1.1 {
        CAPTION POLYR.W.1.1: Poly resistor width must be >= 0.2 um;
        INTE L52444 L52444 -lt 0.2 -OUTPUT REGION -ABUT lt 90;
    }

#ENDIF

#IFDEF CHECK_DFM

    rule NZVT.E.1.DFM {
        CAPTION NZVT.E.1.DFM: Poly to Oxide enclosure must be >= 0.22 um for DFM;
        ENCL L74028 Poly -lt 0.22 -OUTPUT REGION -SINGULAR -ABUT lt 90;
    }

    rule POLY.SP.2.DFM {
        CAPTION POLY.SP.2.DFM: Poly gate to Poly gate spacing must be >= 0.14 um;
        EXTE L70636 L70636 -lt 0.14 -OUTPUT REGION;
    }

    rule POLY.E.1.DFM {
        CAPTION POLY.E.1.DFM: Poly to N+ Oxide enclosure must be >= 0.20 um for DFM;
        ENCL nactive Poly -lt 0.20 -OUTPUT REGION -SINGULAR -ABUT lt 90;
    }

    rule POLY.E.2.DFM {
        CAPTION POLY.E.2.DFM: Poly to P+ Oxide enclosure must be >= 0.20 um for DFM;
        ENCL pactive Poly -lt 0.20 -OUTPUT REGION -SINGULAR -ABUT lt 90;
    }

    rule CONT.SE.1.DFM {
        CAPTION CONT.SE.1.DFM: Cont to gate spacing must be >= 0.12 um for DFM;
        EXTE L43652 L70636 -lt 0.12 -OUTPUT REGION -ABUT lt 90;
        AND L71514 L38830;
    }

    rule CONT.SE.2.DFM {
        CAPTION CONT.SE.2.DFM: Cont to 2.5V gate spacing must be >= 0.14 um for DFM;
        EXTE L42487 L17233 -lt 0.14 -OUTPUT REGION -ABUT lt 90;
        AND L41031 L89566;
    }

    rule CONT.SE.3.DFM {
        CAPTION CONT.SE.3.DFM: Poly Cont to Oxide spacing must be >= 0.14 um for DFM;
        EXTE cont_poly L70386 -lt 0.14 -OUTPUT REGION -ABUT lt 90;
        AND L12965 L47850;
    }

    rule CONT.SE.4.DFM {
        CAPTION CONT.SE.4.DFM: Poly Cont to Oxide spacing must be >= 0.16 um for DFM;
        EXTE cont_poly L70773 -lt 0.16 -OUTPUT REGION -ABUT lt 90;
        AND L12965 L44180;
    }

#ENDIF

#IFDEF SUGGESTED_CHECK

    EDGEINSIDE oxide_in_res resdum_sz L28012;
    rule OXIDER.W.1.2 {
        CAPTION OXIDER.W.1.2: Oxide resistor width must be >= 1.5 um;
        INTE L28012 L28012 -lt 1.5 -OUTPUT REGION -ABUT lt 90;
    }

    EDGEINSIDE resdum_sz oxide_in_res L58689;
    rule OXIDER.L.1 {
        CAPTION OXIDER.L.1: Oxide resistor length must be >= 8.0 um;
        INTE L58689 L58689 -lt 8.0 -OUTPUT REGION -ABUT lt 90;
    }

    EDGEINSIDE poly_in_res resdum_sz L52445;
    rule POLYR.W.1.2 {
        CAPTION POLYR.W.1.2: Poly width must be >= 1.5 um;
        INTE L52445 L52445 -lt 1.5 -OUTPUT REGION -ABUT lt 90;
    }

    EDGEINSIDE resdum_sz poly_in_res L572;
    rule POLYR.L.1 {
