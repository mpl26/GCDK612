// nmos_io_esd=(ndiff_conn and ESDdummy) buttOnly (Poly buttOnly (ndiff_conn connect
//  Bondpad))
AND ESDdummy ndiff_conn L94243;
NET_AREA_RATIO ndiff_conn Bondpad -gt 0 L80382;
TOUCH Poly L80382 L73764;
TOUCH L94243 L73764 nmos_io_esd;

// pmos_io_esd=(pdiff_conn and ESDdummy) buttOnly (Poly buttOnly (pdiff_conn connect
//  Bondpad))
AND ESDdummy pdiff_conn L21253;
NET_AREA_RATIO pdiff_conn Bondpad -gt 0 L64324;
TOUCH Poly L64324 L1826;
TOUCH L21253 L1826 pmos_io_esd;

// rule_ESD_4_nmos=(nsd_esd buttOnly == 1 Poly) andnot ((ndiff_conn connect Bondpad)
//  or (ndiff_conn connect psubstrate))
TOUCH nsd_esd Poly -eq 1 L78152;
NET_AREA_RATIO ndiff_conn psubstrate -gt 0 L10595;
OR L10595 L80382 L87558;
NOT L78152 L87558 rule_ESD_4_nmos;

// rule_ESD_4_pmos=(psd_esd buttOnly == 1 Poly) andnot ((pdiff_conn connect Bondpad)
//  or (pdiff_conn connect nwell_conn ))
TOUCH psd_esd Poly -eq 1 L90202;
NET_AREA_RATIO pdiff_conn nwell_conn -gt 0 L65219;
OR L64324 L65219 L40217;
NOT L90202 L40217 rule_ESD_4_pmos;

// rule_ESD_8_nmos=((nsd_esd buttOnly == 2 Poly) andnot ((ndiff_conn connect Bondpad)
//  or (ndiff_conn connect psubstrate))) outside SiProt
TOUCH nsd_esd Poly -eq 2 L78153;
NOT L78153 L87558 L40153;
OUTSIDE L40153 SiProt rule_ESD_8_nmos;

// rule_ESD_8_pmos=((psd_esd buttOnly == 2 Poly) andnot ((pdiff_conn connect Bondpad)
//  or (pdiff_conn connect psubstrate))) outside SiProt
TOUCH psd_esd Poly -eq 2 L90201;
NET_AREA_RATIO pdiff_conn psubstrate -gt 0 L12421;
OR L12421 L64324 L42888;
NOT L90201 L42888 L65050;
OUTSIDE L65050 SiProt rule_ESD_8_pmos;

rule NBL.W.1 {
    CAPTION NBL.W.1: Nburied width must be >= 3.2 um;
    INTE Nburied Nburied -lt 3.2 -OUTPUT REGION -SINGULAR -ABUT lt 90;
}

rule NBL.E.1 {
    CAPTION NBL.E.1: Nburied to Nwell enclosure must be >= 0.4 um;
    ENCL Nwell Nburied -lt 0.4 -OUTPUT REGION -SINGULAR -ABUT lt 90;
}

rule NBL.SP.1 {
    CAPTION NBL.SP.1: Nburied to Nburied spacing must be >= 5.0 um;
    EXTE Nburied Nburied -lt 5.0 -OUTPUT REGION -NOT_CONNECTED -SINGULAR -NOTCH NOT;
}

CUT Nburied Oxide L58118;
CUT Oxide Nburied L58022;
rule NBL.SE.2 {
    CAPTION NBL.SE.2: Nburied to Oxide spacing must be >= 2.2 um;
    EXTE Nburied Oxide -lt 2.2 -OUTPUT REGION -SINGULAR -ABUT lt 90;
    AND L58118 L58022;
}

rule NBL.SE.1 {
    CAPTION NBL.SE.1: Nburied to non-related Nwell spacing must be >= 4.4 um;
    EXTE Nburied Nwell -lt 4.4 -OUTPUT REGION -SINGULAR -ABUT lt 90;
}

AND Nburied Pimp L9362;
AND L9362 Oxide L26310;
AND L90545 Nburied L23699;
CUT L26310 L23699 L33513;
rule NBL.SE.3 {
    CAPTION NBL.SE.3: Nwell ring (on Nburied) to P+ Oxide spacing must be >= 0.5 um;
    ENCL L26310 L23699 -lt 0.5 -OUTPUT REGION -SINGULAR -ABUT lt 90;
    NOT L33513 L23699;
}

AND Nburied Nimp L68944;
AND L68944 Oxide L75211;
CUT L75211 L23699 L55011;
rule NBL.SE.4 {
    CAPTION NBL.SE.4: Nwell ring (on Nburied) to N+ Oxide spacing must be >= 0.4 um;
    ENCL L75211 L23699 -lt 0.4 -OUTPUT REGION -SINGULAR -ABUT lt 90;
    NOT L55011 L23699;
}

AND bulk rule_NBL_X_1 L2821;
rule NBL.X.1 {
    CAPTION NBL.X.1: Nburied must have an Nwell isolation ring;
    COPY L2821;
}

rule NW.SP.1 {
    CAPTION NW.SP.1: Nwell to Nwell spacing (same potential) must be >= 0.6 um;
    EXTE nwell_conn nwell_conn -lt 0.6 -OUTPUT REGION -CONNECTED -SINGULAR;
}

CUT nwell_conn nwellres L55273;
CUT nwellres nwell_conn L92333;
rule NW.SP.2 {
    CAPTION NW.SP.2: Nwell to Nwell spacing (diferent potential) must be >= 1.2 um;
    EXTE nwell_conn nwellres -lt 1.2 -OUTPUT REGION -SINGULAR -ABUT ltgt 0 90;
    AND L55273 L92333;
}

rule NW.SP.2_2 {
    CAPTION NW.SP.2: Nwell to Nwell spacing (diferent potential) must be >= 1.2 um;
    EXTE nwellres nwellres -lt 1.2 -OUTPUT REGION -SINGULAR;
}

rule NW.W.1 {
    CAPTION NW.W.1: Nwell width must be >= 0.6 um;
    INTE Nwell Nwell -lt 0.6 -OUTPUT REGION -SINGULAR -ABUT lt 90;
}

rule NW.SP.2_3 {
    CAPTION NW.SP.2: Nwell to Nwell spacing (diferent potential) must be >= 1.2 um;
    EXTE nwell_conn nwell_conn -lt 1.2 -OUTPUT REGION -NOT_CONNECTED -SINGULAR -NOTCH NOT;
}

NOT Nwell nwell_in_od_res L81180;
CUT L81180 nactive L61910;
CUT nactive L81180 L16562;
rule NW.SE.1 {
    CAPTION NW.SE.1: Nwell to N+ Oxide spacing must be >= 0.3 um;
    EXTE L81180 nactive -lt 0.3 -OUTPUT REGION -SINGULAR -ABUT lt 90;
    AND L61910 L16562;
}

CUT Nwell pactive L74676;
CUT pactive Nwell L69300;
rule NW.SE.2 {
    CAPTION NW.SE.2: Nwell to P+ Oxide spacing must be >= 0.3 um;
    EXTE Nwell pactive -lt 0.3 -OUTPUT REGION -SINGULAR -ABUT lt 90;
    AND L74676 L69300;
}

AND Nimp Oxide_thk L30848;
AND L30848 Oxide L45795;
CUT Nwell L45795 L83624;
CUT L45795 Nwell L62528;
rule NW.SE.3 {
    CAPTION NW.SE.3: Nwell to N+ 2.5V Oxide spacing must be >= 0.5 um;
    EXTE Nwell L45795 -lt 0.5 -OUTPUT REGION -SINGULAR -ABUT lt 90;
    AND L83624 L62528;
}

AND Oxide_thk Pimp L26476;
AND L26476 Oxide L31437;
CUT Nwell L31437 L37872;
CUT L31437 Nwell L23352;
rule NW.SE.4 {
    CAPTION NW.SE.4: Nwell to P+ 2.5V Oxide spacing must be >= 0.5 um;
    EXTE Nwell L31437 -lt 0.5 -OUTPUT REGION -SINGULAR -ABUT lt 90;
    AND L37872 L23352;
}

NOT Nimp nwell_in_od_res L44712;
AND L44712 Oxide L47914;
CUT L47914 L81180 L17305;
rule NW.E.1 {
    CAPTION NW.E.1: Nwell to N+ Oxide enclosure must be >= 0.12 um;
    ENCL L47914 L81180 -lt 0.12 -OUTPUT REGION -SINGULAR -ABUT lt 90;
    NOT L17305 L81180;
}

rule NW.E.2 {
    CAPTION NW.E.2: Nwell to P+ Oxide enclosure must be >= 0.12 um;
    ENCL pactive Nwell -lt 0.12 -OUTPUT REGION -SINGULAR -ABUT lt 90;
    NOT L69300 Nwell;
}

rule NW.E.3 {
    CAPTION NW.E.3: Nwell to N+ 2.5V Oxide enclosure must be >= 0.7 um;
    ENCL L45795 Nwell -lt 0.7 -OUTPUT REGION -SINGULAR -ABUT lt 90;
