}

LAYDEF SiProt 1085;
LAYERMAP 72 -DATATYPE 0 1085;

LAYDEF Via1 1086;
LAYERMAP 8 -DATATYPE 0 1086;

LAYDEF Via2 1087;
LAYERMAP 10 -DATATYPE 0 1087;

LAYDEF Via3 1088;
LAYERMAP 30 -DATATYPE 0 1088;

LAYDEF Via4 1089;
LAYERMAP 32 -DATATYPE 0 1089;

LAYDEF Via5 1090;
LAYERMAP 34 -DATATYPE 0 1090;

LAYDEF Via6 1091;
LAYERMAP 37 -DATATYPE 0 1091;

LAYDEF Via7 1092;
LAYERMAP 39 -DATATYPE 0 1092;

LAYDEF Via8 1093;
LAYERMAP 41 -DATATYPE 0 1093;

EXTENT bulk;

// Metal1_v=Metal1_p and Metal1_d
AND Metal1_d Metal1_p Metal1_v;

// Metal2_v=Metal2_p and Metal2_d
AND Metal2_d Metal2_p Metal2_v;

// Metal3_v=Metal3_p and Metal3_d
AND Metal3_d Metal3_p Metal3_v;

// Metal4_v=Metal4_p and Metal4_d
AND Metal4_d Metal4_p Metal4_v;

// Metal5_v=Metal5_p and Metal5_d
AND Metal5_d Metal5_p Metal5_v;

// Metal6_v=Metal6_p and Metal6_d
AND Metal6_d Metal6_p Metal6_v;

// Metal7_v=Metal7_p and Metal7_d
AND Metal7_d Metal7_p Metal7_v;

// Metal8_v=Metal8_p and Metal8_d
AND Metal8_d Metal8_p Metal8_v;

// Metal9_v=Metal9_p and Metal9_d
AND Metal9_d Metal9_p Metal9_v;

// Remove the beveled Bondpad edges.
// bondpad_sq=Bondpad downUp 5.0
SIZE Bondpad -BY 5.0 -UNDEROVER bondpad_sq;

// cont_poly=Cont and Poly
AND Cont Poly cont_poly;

// ind_term1=INDdummy and IND2dummy
AND IND2dummy INDdummy ind_term1;

// ind_term2=INDdummy and IND3dummy
AND IND3dummy INDdummy ind_term2;

// nactive=Nimp and Oxide
AND Nimp Oxide nactive;

// nb_tap=Nburied and Nwell
AND Nburied Nwell nb_tap;

// npn_base=Psub and NPNdummy
AND NPNdummy Psub npn_base;

// nwellres=Nwell and ResWdum
AND Nwell ResWdum nwellres;

// oxide_in_res=Oxide cut Resdum
CUT Oxide Resdum oxide_in_res;

// pactive=Pimp and Oxide
AND Oxide Pimp pactive;

// pdiff=pactive andnot Poly
NOT pactive Poly pdiff;

// poly_conn=Poly andnot Resdum
NOT Poly Resdum poly_conn;

// ndiff=(nactive andnot poly_conn)
NOT nactive poly_conn ndiff;

// poly_in_res=Poly cut Resdum
CUT Poly Resdum poly_in_res;

// rule_NZVT_X_4=Nzvt interact > 1 Oxide
INTERACT Nzvt Oxide -gt 1 rule_NZVT_X_4;

// via2_cap=Via2 and CapMetal
AND CapMetal Via2 via2_cap;

// bondpad_to_die_edge=Bondpad drcEncBy < 50.0 ( bulk area > 100000.0 )
AREA bulk -gt 100000.0 L31068;
ENCL Bondpad L31068 -lt 50.0 -PARA ONLY -METRIC OPPOSITE -OUTPUT REGION bondpad_to_die_edge;

// bondpad_via1_array=(( Via1 and Bondpad ) upDown 0.3)
AND Bondpad Via1 L92260;
SIZE L92260 -BY 0.3 -OVERUNDER bondpad_via1_array;

// bondpad_via2_array=(( Via2 and Bondpad ) upDown 0.3)
AND Bondpad Via2 L92259;
SIZE L92259 -BY 0.3 -OVERUNDER bondpad_via2_array;

// bondpad_via3_array=(( Via3 and Bondpad ) upDown 0.3)
AND Bondpad Via3 L92258;
SIZE L92258 -BY 0.3 -OVERUNDER bondpad_via3_array;

// bondpad_via4_array=(( Via4 and Bondpad ) upDown 0.3)
AND Bondpad Via4 L92257;
SIZE L92257 -BY 0.3 -OVERUNDER bondpad_via4_array;

// bondpad_via5_array=(( Via5 and Bondpad ) upDown 0.3)
AND Bondpad Via5 L92256;
SIZE L92256 -BY 0.3 -OVERUNDER bondpad_via5_array;

// bondpad_via6_array=(( Via6 and Bondpad ) upDown 0.3)
AND Bondpad Via6 L92255;
SIZE L92255 -BY 0.3 -OVERUNDER bondpad_via6_array;

// bondpad_via7_array=(( Via7 and Bondpad ) upDown 0.3)
AND Bondpad Via7 L92254;
SIZE L92254 -BY 0.3 -OVERUNDER bondpad_via7_array;

// bondpad_via8_array=(( Via8 and Bondpad ) upDown 0.3)
AND Bondpad Via8 L92253;
SIZE L92253 -BY 0.3 -OVERUNDER bondpad_via8_array;

// cont_base=Cont and npn_base and pdiff
AND Cont npn_base L82025;
AND L82025 pdiff cont_base;

// ndiff_conn=ndiff andnot Resdum andnot NPNdummy
NOT ndiff Resdum L46829;
NOT L46829 NPNdummy ndiff_conn;

// cont_ndiff=Cont and ndiff_conn
AND Cont ndiff_conn cont_ndiff;

// nsd=ndiff_conn buttOnly Poly
TOUCH ndiff_conn Poly nsd;

// nsd_esd=nsd and ESDdummy
AND ESDdummy nsd nsd_esd;

// ntap=Nwell and ndiff_conn
AND Nwell ndiff_conn ntap;

// ntap_esd=ntap and ESDdummy
AND ESDdummy ntap ntap_esd;

// npn_emit=Nwell andnot ResWdum and NPNdummy
NOT Nwell ResWdum L59011;
AND L59011 NPNdummy npn_emit;

// cont_emit=Cont and npn_emit andnot Psub
AND Cont npn_emit L82635;
NOT L82635 Psub cont_emit;

// nwell_conn=Nwell andnot ResWdum andnot NPNdummy
NOT L59011 NPNdummy nwell_conn;

// pdiff_conn=pdiff andnot Resdum andnot NPNdummy
NOT pdiff Resdum L12267;
NOT L12267 NPNdummy pdiff_conn;

// cont_pdiff=Cont and pdiff_conn
AND Cont pdiff_conn cont_pdiff;

// psd=pdiff_conn buttOnly Poly
TOUCH pdiff_conn Poly psd;

// psd_esd=psd and ESDdummy
AND ESDdummy psd psd_esd;

// ptap=(pdiff_conn andnot Nwell)
NOT pdiff_conn Nwell ptap;

// ptap_esd=ptap and ESDdummy
AND ESDdummy ptap ptap_esd;

// rule_ESD_7_nmos=ptap_esd buttOnly nsd_esd
TOUCH ptap_esd nsd_esd rule_ESD_7_nmos;

// rule_ESD_7_pmos=ntap_esd buttOnly psd_esd
TOUCH ntap_esd psd_esd rule_ESD_7_pmos;

// rule_BONDPAD_L_1=bondpad_sq inside (bondpad_to_die_edge grow 68.0)
EXPAND_EDGE bondpad_to_die_edge -OUTSIDE_BY 68.0 L77267;
OR L77267 bondpad_to_die_edge L45856;
INSIDE bondpad_sq L45856 rule_BONDPAD_L_1;

// rule_NBL_X_1=Nburied outside (holes Nwell)
HOLES Nwell L26257;
NOT L26257 Nwell L90545;
OUTSIDE Nburied L90545 rule_NBL_X_1;

// rule_NHVT_X_1=(Oxide and Nhvt) xor Nhvt
AND Nhvt Oxide L46498;
XOR L46498 Nhvt rule_NHVT_X_1;

// rule_PHVT_X_1=(Oxide and Phvt) xor Phvt
AND Oxide Phvt L75618;
XOR L75618 Phvt rule_PHVT_X_1;

// Metal1_d_n=if MergePinAndNet Metal1_d or Metal1_n else Metal1_d
#IFDEF MergePinAndNet
    OR Metal1_d Metal1_n Metal1_d_n;
#ELSE
    COPY Metal1_d Metal1_d_n;
#ENDIF


// Metal1=Metal1_d_n or Metal1_p
OR Metal1_d_n Metal1_p Metal1;

// rule_Bondpad_Missing_M1=Bondpad notInteract Metal1
INTERACT -NOT Bondpad Metal1 rule_Bondpad_Missing_M1;

// metal1_conn=(Metal1 andnot Metal1_slot) andnot M1Resdum
NOT Metal1 Metal1_slot L32159;
NOT L32159 M1Resdum metal1_conn;

