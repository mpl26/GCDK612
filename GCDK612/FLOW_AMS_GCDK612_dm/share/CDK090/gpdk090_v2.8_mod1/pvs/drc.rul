// New:
// - Basic Assura DRC (no pad and esd rules)
// Bug fixes:
// -

INPUT_LAYOUT "CELLNAME.gds";
PRIMARY "CELLNAME";
LIBRARY "LIBNAME";
CHECK_TEXT -DRC -COMMENTS -RFI;
KEEP_EMPTY NO;
MAX_RESULTS -DRC 1000;
MAX_VERTEX -DRC 199;
OUTDISK "./drc.db" -ASCII;
REPORT_SUMMARY -DRC "./drc.sum";

LAYOUT_DEPTH -ALL;
INPUT_FORMAT GDSII;
INPUT_SCALE 1000;
GRID 5;
UNIT -LENGTH U;
UNIT -CAP FF;
UNIT -RES OHM;
UNIT -TIME US;
TEXT_DEPTH -PRIMARY;

FLAG_NONSIMPLE YES;

rule offgrid_check {
    CAPTION Grid violation;
    DRAWN_OFFGRID;
}

rule ortho_45_check {
    CAPTION Orthogonal and 45 degree violation;
    DRAWN_SKEW;
}

LAYDEF empty 999;

LAYDEF Bondpad 1000;
LAYERMAP 36 -DATATYPE 0 1000;

rule Bondpad_acute_angle {
    CAPTION acute angle on layer Bondpad;
    INTE Bondpad Bondpad -lt 0.01 -OUTPUT REGION -SINGULAR -ABUT lt 90;
}

LAYDEF CapMetal 1001;
LAYERMAP 14 -DATATYPE 0 1001;

rule CapMetal_acute_angle {
    CAPTION acute angle on layer CapMetal;
    INTE CapMetal CapMetal -lt 0.01 -OUTPUT REGION -SINGULAR -ABUT lt 90;
}

LAYDEF Cont 1002;
LAYERMAP 6 -DATATYPE 0 1002;

LAYDEF ESDdummy 1003;
LAYERMAP 74 -DATATYPE 0 1003;

