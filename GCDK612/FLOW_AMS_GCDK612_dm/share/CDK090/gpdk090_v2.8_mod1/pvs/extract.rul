DEVICE RES (ressndiff) _rndiff ndiff_conn(PLUS) ndiff_conn(MINUS) psubstrate(B) (PLUS MINUS)
[ PROPERTY r,segR,w,segW,l,segL,effL
    width=PERIM_CO_IN(_rndiff, ndiff_conn)/2
    lengthx=PERIM_CO_OUT(_rndiff, ndiff_conn)/2
    r=((lengthx - (0.45 * BENDS(_rndiff) * width))/ width) * 10.0
    segR=((lengthx - (0.45 * BENDS(_rndiff) * width))/ width) * 10.0
    w=width * 1.0e-6
    segW=width * 1.0e-6
    l=(lengthx - (0.45 * BENDS(_rndiff) * width)) * 1.0e-6
    segL=(lengthx - (0.45 * BENDS(_rndiff) * width)) * 1.0e-6
    effL=(lengthx - (0.45 * BENDS(_rndiff) * width)) * 1.0e-6
];

