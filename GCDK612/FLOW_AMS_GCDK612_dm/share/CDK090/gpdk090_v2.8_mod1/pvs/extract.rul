// ind_term2_tap=Metal2 and INDdummy and IND3dummy
AND IND3dummy L41497 ind_term2_tap;

// metal2_conn=(Metal2 andnot Metal2_slot) andnot M2Resdum
NOT L6015 M2Resdum metal2_conn;

// MIMCAP=CapMetal and metal2_conn
AND CapMetal metal2_conn MIMCAP;

