DEVICE C (mimcap) MIMCAP CapMetal(PLUS) metal2_conn(MINUS)
[ PROPERTY w,l,c,area,perim
    w=((PERIMETER(MIMCAP)*0.25) + 0.5*sqrt( (0.25*POW(PERIMETER(MIMCAP),2) - (4)*AREA(MIMCAP)) ))*1e-6
    l=((PERIMETER(MIMCAP)*0.25) - 0.5*sqrt( (0.25*POW(PERIMETER(MIMCAP),2) - (4)*AREA(MIMCAP)) ))*1e-6
    c=AREA(MIMCAP)*1e-15 + PERIMETER(MIMCAP)*1e-16
    area=AREA(MIMCAP)*1e-12
    perim=PERIMETER(MIMCAP)*1e-6
];

