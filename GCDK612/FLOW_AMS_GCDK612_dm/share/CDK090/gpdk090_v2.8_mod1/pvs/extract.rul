#IFDEF MergePinAndNet
    OR Metal9_d Metal9_n Metal9_d_n;
#ELSE
    COPY Metal9_d Metal9_d_n;
#ENDIF


// Metal9=Metal9_d_n or Metal9_p
OR Metal9_d_n Metal9_p Metal9;

// bp_tap=Bondpad and Metal9
AND Bondpad Metal9 bp_tap;

// _resm9=(Metal9 andnot Metal9_slot) and M9Resdum
NOT Metal9 Metal9_slot L44289;
AND L44289 M9Resdum _resm9;

// metal9_conn=(Metal9 andnot Metal9_slot) andnot M9Resdum
NOT L44289 M9Resdum metal9_conn;

// _ndio=(DIOdummy and Oxide and Nimp) andnot Nwell
AND DIOdummy Oxide L54696;
AND L54696 Nimp L65805;
NOT L65805 Nwell _ndio;

// _pdio=(DIOdummy and Oxide and Pimp) and Nwell
AND L54696 Pimp L25387;
AND L25387 Nwell _pdio;

// npn_coll=ndiff andnot Resdum and NPNdummy and Psub
AND L46829 NPNdummy L69474;
AND L69474 Psub npn_coll;

// _npn=(npn_coll and NPNdummy)
AND NPNdummy npn_coll _npn;

// cont_coll=Cont and npn_coll
AND Cont npn_coll cont_coll;

// via2_out_capInd=Via2 and Metal2 andnot (CapMetal or INDdummy)
AND Metal2 Via2 L98704;
OR CapMetal INDdummy L47735;
NOT L98704 L47735 via2_out_capInd;

// _pmos_12_hvt=(((Oxide andnot Oxide_thk) and Poly) and Pimp) and Phvt
NOT Oxide Oxide_thk L28394;
AND L28394 Poly L66375;
AND L66375 Pimp L29970;
AND L29970 Phvt _pmos_12_hvt;

// _pmoscap_25=((Oxide and Oxide_thk) and Poly) and Pimp and Capdum
AND Oxide Oxide_thk L24975;
AND L24975 Poly L98842;
AND L98842 Pimp L73768;
AND Capdum L73768 _pmoscap_25;

// _pmoscap_25_3=((Oxide and Oxide_thk) and Poly) and Pimp and Cap3dum
AND Cap3dum L73768 _pmoscap_25_3;

// _rndiff=(((Oxide and Nimp) notInteract SiProt) and Resdum) andnot Nwell
INTERACT -NOT nactive SiProt L62496;
AND L62496 Resdum L426;
NOT L426 Nwell _rndiff;

// _rndiff_nosal=(((Oxide and Nimp) and SiProt) and Resdum) andnot Nwell
AND SiProt nactive L18758;
AND L18758 Resdum L23316;
NOT L23316 Nwell _rndiff_nosal;

// _rnpoly=((Poly andnot SiProt) and Nimp) and Resdum andnot Nwell
NOT Poly SiProt L90381;
AND L90381 Nimp L49196;
AND L49196 Resdum L17878;
NOT L17878 Nwell _rnpoly;

// _rnpoly_nosal=((Poly and SiProt) and Nimp) and Resdum andnot Nwell
AND Poly SiProt L5240;
AND L5240 Nimp L1378;
AND L1378 Resdum L66582;
NOT L66582 Nwell _rnpoly_nosal;

// _rnpolynw=((Poly andnot SiProt) and Nimp) and Resdum and Nwell
AND L17878 Nwell _rnpolynw;

// _rnpolynw_nosal=((Poly and SiProt) and Nimp) and Resdum and Nwell
AND L66582 Nwell _rnpolynw_nosal;

// _rpdiff=(((Oxide and Pimp) notInteract SiProt) and Resdum) and Nwell
INTERACT -NOT pactive SiProt L79746;
AND L79746 Resdum L22728;
AND L22728 Nwell _rpdiff;

// _rpdiff_nosal=(((Oxide and Pimp) and SiProt) and Resdum) and Nwell
AND SiProt pactive L88604;
AND L88604 Resdum L197;
AND L197 Nwell _rpdiff_nosal;

// _rppoly=((Poly andnot SiProt) and Pimp) and Resdum andnot Nwell
AND L90381 Pimp L8778;
AND L8778 Resdum L54937;
NOT L54937 Nwell _rppoly;

// _rppoly_nosal=((Poly and SiProt) and Pimp) and Resdum andnot Nwell
AND L5240 Pimp L60960;
AND L60960 Resdum L4294;
NOT L4294 Nwell _rppoly_nosal;

// _rppolynw=((Poly andnot SiProt) and Pimp) and Resdum and Nwell
AND L54937 Nwell _rppolynw;

// _rppolynw_nosal=((Poly and SiProt) and Pimp) and Resdum and Nwell
AND L4294 Nwell _rppolynw_nosal;

// _pmos_25=((Oxide and Oxide_thk) and Poly) and Pimp andnot (Capdum or Cap3dum)
OR Cap3dum Capdum L8948;
NOT L73768 L8948 _pmos_25;

// _pmoscap_12=(((Oxide andnot Oxide_thk) and Poly) and Pimp) andnot Phvt and Capdum
NOT L29970 Phvt L62733;
AND Capdum L62733 _pmoscap_12;

// _pmoscap_12_3=(((Oxide andnot Oxide_thk) and Poly) and Pimp) andnot Phvt and Cap3dum
AND Cap3dum L62733 _pmoscap_12_3;

// _nmos_12_hvt=(((((Oxide andnot Oxide_thk) and Poly) and Nimp) andnot Nzvt) and Nhvt)
//  andnot Nburied
AND L66375 Nimp L89552;
NOT L89552 Nzvt L25441;
AND L25441 Nhvt L941;
NOT L941 Nburied _nmos_12_hvt;

// _nmos_12_iso=(((((Oxide andnot Oxide_thk) and Poly) and Nimp) andnot Nzvt) andnot
//  Nhvt) and Nburied
NOT L25441 Nhvt L70734;
AND L70734 Nburied _nmos_12_iso;

// _nmos_12_native=(((((Oxide andnot Oxide_thk) and Poly) and Nimp) and Nzvt) andnot
//  Nhvt) andnot Nburied
AND L89552 Nzvt L70180;
NOT L70180 Nhvt L21328;
NOT L21328 Nburied _nmos_12_native;

// _nmos_25_native=(((((Oxide and Oxide_thk) and Poly) and Nimp) and Nzvt) andnot Nhvt)
//  andnot Nburied
AND L98842 Nimp L14186;
AND L14186 Nzvt L15681;
NOT L15681 Nhvt L10869;
NOT L10869 Nburied _nmos_25_native;

// _pmos_12=(((Oxide andnot Oxide_thk) and Poly) and Pimp) andnot Phvt andnot (Capdum
//  or Cap3dum)
NOT L62733 L8948 _pmos_12;

// psubstrate=(bulk andnot (Nburied and Nwell)) andnot (Psub andnot (Psub size -0.001))
//  andnot NPNdummy
NOT bulk nb_tap L14174;
SIZE Psub -BY -0.001 L86601;
NOT Psub L86601 L7495;
NOT L14174 L7495 L43912;
NOT L43912 NPNdummy psubstrate;

// _nmoscap_12=(((((Oxide andnot Oxide_thk) and Poly) and Nimp) andnot Nzvt) andnot
//  Nhvt) andnot Nburied and Capdum
NOT L70734 Nburied L8530;
AND Capdum L8530 _nmoscap_12;

// _nmoscap_12_3=(((((Oxide andnot Oxide_thk) and Poly) and Nimp) andnot Nzvt) andnot
//  Nhvt) andnot Nburied and Cap3dum
AND Cap3dum L8530 _nmoscap_12_3;

// _nmoscap_25=(((((Oxide and Oxide_thk) and Poly) and Nimp) andnot Nzvt) andnot Nhvt)
//  andnot Nburied and Capdum
NOT L14186 Nzvt L55994;
NOT L55994 Nhvt L55604;
NOT L55604 Nburied L64343;
AND Capdum L64343 _nmoscap_25;

// _nmoscap_25_3=(((((Oxide and Oxide_thk) and Poly) and Nimp) andnot Nzvt) andnot Nhvt)
//  andnot Nburied and Cap3dum
AND Cap3dum L64343 _nmoscap_25_3;

// _nmos_12=(((((Oxide andnot Oxide_thk) and Poly) and Nimp) andnot Nzvt) andnot Nhvt)
//  andnot Nburied andnot (Capdum or Cap3dum)
NOT L8530 L8948 _nmos_12;

// _nmos_25=(((((Oxide and Oxide_thk) and Poly) and Nimp) andnot Nzvt) andnot Nhvt)
//  andnot Nburied andnot (Capdum or Cap3dum)
NOT L64343 L8948 _nmos_25;

