// Metal1_v=Metal1_p and Metal1_d
AND Metal1_d Metal1_p Metal1_v;

// Metal2_v=Metal2_p and Metal2_d
AND Metal2_d Metal2_p Metal2_v;

// Metal3_v=Metal3_p and Metal3_d
AND Metal3_d Metal3_p Metal3_v;

// Metal4_v=Metal4_p and Metal4_d
AND Metal4_d Metal4_p Metal4_v;

// Metal5_v=Metal5_p and Metal5_d
AND Metal5_d Metal5_p Metal5_v;

// Metal6_v=Metal6_p and Metal6_d
AND Metal6_d Metal6_p Metal6_v;

// Metal7_v=Metal7_p and Metal7_d
AND Metal7_d Metal7_p Metal7_v;

// Metal8_v=Metal8_p and Metal8_d
AND Metal8_d Metal8_p Metal8_v;

// Metal9_v=Metal9_p and Metal9_d
AND Metal9_d Metal9_p Metal9_v;

// cont_poly=Cont and Poly
AND Cont Poly cont_poly;

// ind_term1=INDdummy and IND2dummy
AND IND2dummy INDdummy ind_term1;

// ind_term2=INDdummy and IND3dummy
AND IND3dummy INDdummy ind_term2;

// nactive=Nimp and Oxide
AND Nimp Oxide nactive;

// nb_tap=Nburied and Nwell
AND Nburied Nwell nb_tap;

// npn_base=Psub and NPNdummy
AND NPNdummy Psub npn_base;

// pactive=Pimp and Oxide
AND Oxide Pimp pactive;

// pdiff=pactive andnot Poly
NOT pactive Poly pdiff;

// poly_conn=Poly andnot Resdum
NOT Poly Resdum poly_conn;

// ndiff=(nactive andnot poly_conn)
NOT nactive poly_conn ndiff;

// via2_cap=Via2 and CapMetal
AND CapMetal Via2 via2_cap;

// _rnwellod=(Nwell and SiProt) and ResWdum
AND Nwell SiProt L40182;
AND L40182 ResWdum _rnwellod;

// _rnwellsti=(Nwell notInteract SiProt) and ResWdum
INTERACT -NOT Nwell SiProt L25544;
AND L25544 ResWdum _rnwellsti;

// cont_base=Cont and npn_base and pdiff
AND Cont npn_base L82025;
AND L82025 pdiff cont_base;

// ndiff_conn=ndiff andnot Resdum andnot NPNdummy
NOT ndiff Resdum L46829;
NOT L46829 NPNdummy ndiff_conn;

// cont_ndiff=Cont and ndiff_conn
AND Cont ndiff_conn cont_ndiff;

// ntap=Nwell and ndiff_conn
AND Nwell ndiff_conn ntap;

// npn_emit=Nwell andnot ResWdum and NPNdummy
NOT Nwell ResWdum L59011;
AND L59011 NPNdummy npn_emit;

// cont_emit=Cont and npn_emit andnot Psub
AND Cont npn_emit L82635;
NOT L82635 Psub cont_emit;

// nwell_conn=Nwell andnot ResWdum andnot NPNdummy
NOT L59011 NPNdummy nwell_conn;

// pdiff_conn=pdiff andnot Resdum andnot NPNdummy
NOT pdiff Resdum L12267;
NOT L12267 NPNdummy pdiff_conn;

// _pnp=(pdiff_conn and PNPdummy)
AND PNPdummy pdiff_conn _pnp;

// cont_pdiff=Cont and pdiff_conn
AND Cont pdiff_conn cont_pdiff;

// ptap=(pdiff_conn andnot Nwell)
NOT pdiff_conn Nwell ptap;

// _vpnp2=(pdiff_conn and BJTdum and VPNP2dum)
AND BJTdum pdiff_conn L68803;
AND L68803 VPNP2dum _vpnp2;

// _vpnp5=(pdiff_conn and BJTdum and VPNP5dum)
AND L68803 VPNP5dum _vpnp5;

// _vpnp10=(pdiff_conn and BJTdum and VPNP10dum)
AND L68803 VPNP10dum _vpnp10;

// Metal1_d_n=if MergePinAndNet Metal1_d or Metal1_n else Metal1_d
#IFDEF MergePinAndNet
    OR Metal1_d Metal1_n Metal1_d_n;
#ELSE
    COPY Metal1_d Metal1_d_n;
#ENDIF


// Metal1=Metal1_d_n or Metal1_p
OR Metal1_d_n Metal1_p Metal1;

// _resm1=(Metal1 andnot Metal1_slot) and M1Resdum
NOT Metal1 Metal1_slot L32159;
AND L32159 M1Resdum _resm1;

// metal1_conn=(Metal1 andnot Metal1_slot) andnot M1Resdum
NOT L32159 M1Resdum metal1_conn;

// Metal2_d_n=if MergePinAndNet Metal2_d or Metal2_n else Metal2_d
#IFDEF MergePinAndNet
    OR Metal2_d Metal2_n Metal2_d_n;
#ELSE
