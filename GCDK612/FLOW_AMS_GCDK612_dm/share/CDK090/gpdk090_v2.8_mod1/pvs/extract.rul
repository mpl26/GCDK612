    r=((lengthx - (0.45 * BENDS(_resm2) * width))/ width) * 0.06
    segR=((lengthx - (0.45 * BENDS(_resm2) * width))/ width) * 0.06
    w=width * 1.0e-6
    segW=width * 1.0e-6
    l=(lengthx - (0.45 * BENDS(_resm2) * width)) * 1.0e-6
    segL=(lengthx - (0.45 * BENDS(_resm2) * width)) * 1.0e-6
    effL=(lengthx - (0.45 * BENDS(_resm2) * width)) * 1.0e-6
];

