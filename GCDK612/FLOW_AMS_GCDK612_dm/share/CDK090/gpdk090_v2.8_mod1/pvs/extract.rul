INPUT_LAYOUT "CELLNAME.gds";
PRIMARY "CELLNAME";
LIBRARY "LIBNAME";
CHECK_TEXT -DRC -COMMENTS -RFI;
KEEP_EMPTY NO;
MAX_RESULTS -DRC 1000;
MAX_VERTEX -DRC 199;
OUTDISK "./drc.db" -ASCII;
REPORT_SUMMARY -DRC "./drc.sum";

LAYOUT_DEPTH -ALL;
INPUT_FORMAT GDSII;
INPUT_SCALE 1000;
GRID 5;
UNIT -LENGTH U;
UNIT -CAP FF;
UNIT -RES OHM;
UNIT -TIME US;
TEXT_DEPTH -PRIMARY;

LAYDEF empty 999;

LAYDEF BJTdum 1000;
LAYERMAP 15 -DATATYPE 0 1000;

LAYDEF Bondpad 1001;
LAYERMAP 36 -DATATYPE 0 1001;

LAYDEF Cap3dum 1002;
LAYERMAP 84 -DATATYPE 0 1002;

LAYDEF CapMetal 1003;
LAYERMAP 14 -DATATYPE 0 1003;

LAYDEF Capdum 1004;
LAYERMAP 12 -DATATYPE 0 1004;

LAYDEF Cont 1005;
LAYERMAP 6 -DATATYPE 0 1005;

LAYDEF DIOdummy 1006;
LAYERMAP 22 -DATATYPE 0 1006;

LAYDEF IND2dummy 1007;
LAYERMAP 17 -DATATYPE 0 1007;

LAYDEF IND3dummy 1008;
LAYERMAP 70 -DATATYPE 0 1008;

LAYDEF INDdummy 1009;
LAYERMAP 16 -DATATYPE 0 1009;

LAYDEF M1Resdum 1010;
LAYERMAP 75 -DATATYPE 0 1010;

