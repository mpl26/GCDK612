;; 
;; Program to Print the Hierarchy Tree on the Schematic Editor
;; The Menu appears on the Design->Hierarchy Menu on the Schematic Editor
;; 
;------------------------------------------------------------------------;
; Adding tree in the regular menus. Scroll down for Tree Code
;------------------------------------------------------------------------;
procedure( CdsAddHierSliderItem()
;tracef(t)
let( (a fileMenu slider )

fileMenu = car( setof( menu hiGetBannerMenus(hiGetCurrentWindow()) rexMatchp("^schFileMenu" menu) ) )

if( fileMenu 
  slider=eval( 
         car( 
          setof( item eval(fileMenu)->? rexMatchp("^schHierSlider" item ) ) 
         ) 
       ) 
)
a = hiCreateMenuItem(
		?name 'two1
		?itemText "Schematic Tree"
		?callback "CdsShowTree()"
		)
when( !slider->two1 hiInsertMenuItem(slider a length( slider->?) ))

);let
;untrace()
);procedure

procedure( CdsUserPostInstallTrigger( args )
;  hiInsertBannerMenu(
;  args->window 

;when( !boundp('two1)
    CdsAddHierSliderItem()
;  )
;  length( hiGetBannerMenus( args->window ))
;)
)

deUnRegUserTriggers( "schematic")
deRegUserTriggers( "schematic" nil nil 'CdsUserPostInstallTrigger)


;------------------------------------------------------------------------;
; Schematic Tree. 
;------------------------------------------------------------------------;
procedure( CdsShowTree( @key (cvId geGetEditCellView()) 
                        (tab "") 
                        (viewList "schematic cmos_sch symbol")
                         port 
                         ) 
  let( (file title sum_comp_count)
        unless( port && portp(port)
               ;port = poport
                port = outfile( file=makeTempFileName( "/tmp/tree" ) )
                )
sum_comp_count = 0
mfactor = 1	
;tracef(t)
;-------------------------------------------------
; RayV: Get techlib name and create a cell list
  foreach( libProp ddGetObj(cvId~>libName)~>prop 
           when( libProp~>name == "techLibName" 
	         techLibName = libProp~>value
		 techLibCellList = ddGetObj(techLibName)~>cells~>name
		 )
          );end foreach libProp
;Create a table with initial value of 0	  
 cellTable = makeTable("tableOfCellName" 0)
 foreach( cellName techLibCellList
          cellTable[cellName]=0
	  ) 	  
;---------------------------------------------------------------  
fprintf( port "\
\n                                          Design Hierarchy                                          \
\n****************************************************************************************************\
\nLibrary     : %s\
\nCell        : %s\
\nView        : %s\
\nOption      : Top to bottom\
\nStop Level  : Top to bottom \
\n****************************************************************************************************\n\n"
    cvId~>libName cvId~>cellName cvId~>viewName )

   goDeep( cvId 
           ?tab strcat(tab "  ;") 
           ?viewList viewList 
           ?port port
	   )
    fprintf( port "*************************************************************************\n")
    foreach( key cellTable
             when( cellTable[key] > 0   
	           fprintf( port "\n    %-15s = %10d" key cellTable[key] )
		   )
            )
    fprintf( port "\n--------------------------------------------------------")
    forall( key cellTable 
            sum_comp_count =  sum_comp_count + cellTable[key] )
                   fprintf( port "\n    Sum             = %10d \n" sum_comp_count )
    
    drain(port)
    sprintf( title "CDS Tree: %s/%s/%s" cvId~>libName cvId~>cellName cvId~>viewName )
    view( file list(25:25 900:800) title ) 
    deleteFile(file)
  )
)

;-------------------------------------------------------------------------------
procedure( goDeep( cvId @key 
                   (tab "  ;") 
                   (viewList "schematic cmos_sch symbol")
                   (port poport)
		   ) 
  let((inst tmp )
  
  
  foreach( hdr cvId~>instHeaders
    if( (length(hdr~>instances) > 0) 
        && (inst = car( hdr~>instances )) 
        && (tmp = dbGetAnyInstSwitchMaster( inst viewList )) then
	
        unless( rexMatchp("basic" hdr->libName ) ||
                rexMatchp("sheet_" hdr->cellName)
;tracef(t)	       
	        if( rexMatchList(hdr->cellName techLibCellList ) 
	            && hdr->libName == techLibName 
		    then
		        cellTable[hdr->cellName] = cellTable[hdr->cellName]+length(hdr~>instances)*mfactor
		    else
		        mfactor = length(hdr~>instances) 
                   ); end if rexm
	       
               fprintf( port "%s%s %s %s (%d) \n" 
                        tab 
                        hdr->libName 
                        hdr->cellName 
                        hdr->viewName  
                        length(hdr~>instances)
	                )
;untrace()			
	         ); end unless  
		 	       
    unless( tmp->cellViewType == "schematicSymbol" 
             goDeep( tmp 
                     ?tab strcat(tab "  ;") 
                     ?viewList viewList 
                     ?port port
                     )
            )
      ;printf("%s DEADEND\n" tab)
    ); end if length 
  ); end foreach hdr
  drain( port )
  )
)
